# Database
DATABASE_URL=sqlite:///./data/app.db

# LangSmith Monitoring (optional — for tracing LangChain RAG pipeline)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=Multi-Agent-Job-Search-System
ENV=local