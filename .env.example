# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini/gemini-3.1-flash

# USAJobs API
USAJOBS_API_KEY=

# AgentOps Monitoring
AGENTOPS_API_KEY=

# JWT Secret (change in production!)
